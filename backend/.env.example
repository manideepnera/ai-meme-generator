# =============================================================================
# AI Meme Generator Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name (optional, has default)
APP_NAME=AI Meme Generator Backend

# Application version (optional, has default)
APP_VERSION=1.0.0

# Debug mode - set to true for development (enables hot reload)
DEBUG=false

# =============================================================================
# GOOGLE GEMINI API (Google AI Studio)
# =============================================================================

# Required for all meme generation. Keep this key on the backend only.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# =============================================================================
# GOOGLE COLAB SETTINGS
# =============================================================================

# REQUIRED: Google Colab endpoint URL
# This is the URL exposed by your Colab notebook (via ngrok or similar).
# 
# IMPORTANT: Colab URLs are temporary and change on each session restart!
# You'll need to update this each time you restart your Colab notebook.
#
# Examples:
#   ngrok: https://abc123.ngrok.io/generate
#   Cloudflare Tunnel: https://my-colab.trycloudflare.com/generate
#
COLAB_API_URL=

# Optional: Colab API authentication key
# Only needed if you've added authentication to your Colab endpoint.
COLAB_API_KEY=

# Timeout for Colab API calls (in seconds)
# Image generation can take longer, so this should be higher than LLaMA timeout.
COLAB_TIMEOUT=120

# =============================================================================
# AWS CREDENTIALS (Only if using AWS Signature V4 authentication)
# =============================================================================

# Only required if LLAMA_AUTH_TYPE=aws_signature
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Allowed origins for CORS (comma-separated)
# In production, set this to your actual frontend URL(s).
#
# Examples:
#   Development: http://localhost:3000,http://127.0.0.1:3000
#   Production: https://your-frontend.com,https://www.your-frontend.com
#
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
