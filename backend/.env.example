# LLaMA 3 text generation
LLAMA_API_URL=
LLAMA_API_KEY=
LLAMA_AUTH_TYPE=bearer
LLAMA_TIMEOUT=90

# Stable Diffusion XL image generation endpoint
# Expected POST JSON: {"prompt":"...", "negative_prompt":"..."}
# Expected response: {"image_base64":"..."} OR {"image_url":"..."} OR image bytes
SDXL_API_URL=
SDXL_API_KEY=
SDXL_TIMEOUT=180

# BLIP-2 image understanding endpoint
# Expected POST JSON: {"image_base64":"...", "question":"..."}
# Expected response JSON: {"caption":"...", "answer":"..."}
BLIP2_API_URL=
BLIP2_API_KEY=
BLIP2_TIMEOUT=90

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
